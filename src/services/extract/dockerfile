FROM python:3.14.3-alpine3.23 AS base
RUN python -m pip install --upgrade pip setuptools
RUN apk update && apk upgrade --no-cache

FROM base AS back-builder

WORKDIR /app

RUN apk add --no-cache \
  build-base \
  libffi-dev \
  rust \
  cargo

# TODO: requirements.txt
COPY ./src/backend /app

RUN mkdir /install && \
  pip install --prefix=/install .


###########################################################
# Use a lightweight Python image
FROM python:3.11-slim

# 1. Set environment variables
# Prevents Python from writing .pyc files and ensures output is sent to logs immediately
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV FLASK_ENV=production

# 2. Create and set the working directory
WORKDIR /app

# 3. Install dependencies
# We copy this first to leverage Docker's layer caching
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 4. Copy the rest of the application code
COPY . .

# 5. Security: Create a non-root user and switch to it
RUN adduser --disabled-password --gecos '' flaskuser
USER flaskuser

# 6. Expose the port Gunicorn will listen on
EXPOSE 8000

# 7. Start Gunicorn
# -w 4: Number of worker processes (usually 2 x cores + 1)
# -b 0.0.0.0:8000: Bind to all interfaces on port 8000
CMD ["gunicorn", "--workers", "4", "--bind", "0.0.0.0:8000", "wsgi:app"]
